# Public address of the site, no trailing slash. Used for SEO links and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional. If set, every demo request is POSTed here as JSON
# (works with Slack, Zapier, Make, n8n or your own endpoint).
# If empty, requests are only written to the server log.
CONTACT_WEBHOOK_URL=
