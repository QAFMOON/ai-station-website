# Public address of the site, no trailing slash. Used for SEO links and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional. If set, every demo, pilot or quote request is POSTed here as JSON
# (works with Slack, Zapier, Make, n8n or your own endpoint).
# If empty, requests are only written to the server log.
CONTACT_WEBHOOK_URL=

# Optional. If all three are set, every demo, pilot or quote request is added as a new row in this Airtable table.
# AIRTABLE_TOKEN: a personal access token with the data.records:write scope for that base.
# AIRTABLE_BASE_ID: starts with "app". AIRTABLE_TABLE_ID: starts with "tbl" (or use the table name).
# The table needs these columns (text fields): Name, Email, Company, Inquiry type, Message, Language, Received at.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=
